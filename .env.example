# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. .env is gitignored.
# Every variable the platform needs MUST be listed here, with a safe dummy
# value, so a new engineer can start from a fresh clone with no guesswork.
# ---------------------------------------------------------------------------

# --- Postgres (one container, three logical databases) ---------------------
POSTGRES_USER=platform
POSTGRES_PASSWORD=change_me_locally
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

ANALYTICS_DB=analytics          # your warehouse
AIRFLOW_DB=airflow              # Airflow's own bookkeeping
METABASE_DB=metabase            # Metabase's dashboard storage

# Read-only user Metabase connects with (least privilege)
METABASE_READONLY_USER=metabase_ro
METABASE_READONLY_PASSWORD=change_me_locally

# --- MinIO (S3-compatible object storage) ----------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_locally
MINIO_ENDPOINT=http://minio:9000
MINIO_RAW_BUCKET=raw
MINIO_ARCHIVE_BUCKET=archive

# --- Airflow ---------------------------------------------------------------
# Leave unset to build docker/airflow/Dockerfile locally. CI overrides this to
# a ghcr.io tag when running against a published image.
# AIRFLOW_IMAGE=mini-data-platform-airflow:local
# Leave this at 50000 (the image's built-in "airflow" user) - do NOT set it
# to your own host uid. That's the usual advice for this variable, but it
# doesn't work here: airflow-init overrides the image's entrypoint to run
# its own migrate/create-user commands, which bypasses whatever UID handling
# the image normally provides, so an unrecognised uid crashes the `airflow`
# CLI outright ("getpwuid(): uid not found"). If `./logs` isn't writable by
# uid 50000 on your machine (Linux), run this once instead:
#   mkdir -p logs && chmod -R a+rwx logs
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_locally
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false

# --- Metabase ----------------------------------------------------------------
# Used once by `make metabase-setup` to create the admin account (first run
# only) and log in on every later run.
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change_me_locally

# --- Pipeline behaviour ----------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=2

# --- Monitoring --------------------------------------------------------------
# Optional. Leave unset to just log failures instead of alerting to Slack.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
